#!/usr/bin/env bash

#ddev-generated
## Description: Query the Codebase Memory knowledge graph (any MCP tool, from the CLI)
## Usage: cbm [index|ui on|off|shell|logs|version|<tool> [flags]]
## Example: "ddev cbm index" to (re)index, "ddev cbm list_projects", "ddev cbm search_graph --label Function --name-pattern '.*Handler.*'", "ddev cbm ui" for the graph UI URL
## ExecRaw: true

set -eu -o pipefail

SERVICE="codebase-memory"
PROJECT_ROOT="/var/www/html"
ENV_FILE="${DDEV_APPROOT}/.ddev/.env.${SERVICE}"

# `ddev exec` hands the command to a shell inside the container, so arguments
# must be quoted or the shell rewrites them: a regex like '.*' would otherwise
# glob-expand against the project directory before the tool ever sees it.
#
# stdin is closed because the CLI also accepts tool arguments as JSON on stdin:
# with an inherited non-TTY stdin (any pipeline, script or CI job) it blocks
# waiting for input that is never coming. Arguments are always passed as flags here.
in_container() {
  local cmd="" a
  for a in "$@"; do
    cmd="${cmd:+$cmd }$(printf '%q' "$a")"
  done
  ddev exec -s "${SERVICE}" bash -c "${cmd}" </dev/null
}

usage() {
  cat <<'EOF'
ddev cbm — Codebase Memory knowledge graph

  ddev cbm index                 (Re)index this project into the graph
  ddev cbm status                Indexing status of this project
  ddev cbm list_projects         Projects in the graph, with node/edge counts
  ddev cbm ui                    Show the graph UI URL and whether it is up
  ddev cbm logs [-f]             Container logs (indexing progress lives here)
  ddev cbm shell                 A shell inside the server container
  ddev cbm version               Installed codebase-memory-mcp version

  ddev cbm <tool> [flags]        Run any MCP tool as a one-shot command
  ddev cbm <tool> --help         Flags for that tool

Query tools take --project; it is filled in automatically when this project is
the only one in the graph. Examples:

  ddev cbm get_graph_schema
  ddev cbm search_graph --label Function --name-pattern '.*Handler.*'
  ddev cbm trace_path --function-name doSomething --direction both
  ddev cbm get_architecture
EOF
}

# Tools that operate on an already-indexed project need --project. Resolve it
# from the graph so callers do not have to know the name CBM derived.
resolve_project() {
  in_container codebase-memory-mcp cli list_projects 2>/dev/null \
    | jq -r '[.. | objects | select(has("name")) | .name] | .[0] // empty' 2>/dev/null \
    || true
}

needs_project() {
  # index_repository is addressed by --repo-path and list_projects spans all
  # projects; everything else, get_graph_schema included, requires --project.
  case "$1" in
    index_repository|list_projects) return 1 ;;
    *) return 0 ;;
  esac
}

has_project_flag() {
  for a in "$@"; do
    case "$a" in --project|--project=*) return 0 ;; esac
  done
  return 1
}

case "${1:-}" in
  ""|-h|--help|help)
    usage
    ;;

  index)
    shift
    echo "Indexing ${PROJECT_ROOT} — this can take a while on a large repository."
    # No --name: agent sessions auto-index under the path-derived name, so naming
    # it anything else here just creates a second, redundant graph.
    # Extra flags pass through, e.g. --persistence true, --mode fast.
    in_container codebase-memory-mcp cli --progress index_repository \
      --repo-path "${PROJECT_ROOT}" "$@"
    ;;

  status)
    shift
    project="$(resolve_project)"
    if [ -n "${project}" ]; then
      in_container codebase-memory-mcp cli index_status --project "${project}" "$@"
    else
      echo "Nothing indexed yet. Run: ddev cbm index" >&2
      exit 1
    fi
    ;;

  ui)
    shift
    # A discoverability command: there is nothing to switch on, so this reports
    # where the UI lives and whether it is currently up.
    # The env file only exists once someone overrides a port; `|| true` keeps the
    # defaults working under `set -e` when it is absent.
    http_port="$(sed -n 's/^CBM_UI_HTTP_EXPOSE="\{0,1\}\([0-9]*\).*/\1/p' "${ENV_FILE}" 2>/dev/null | tail -1 || true)"
    https_port="$(sed -n 's/^CBM_UI_HTTPS_EXPOSE="\{0,1\}\([0-9]*\).*/\1/p' "${ENV_FILE}" 2>/dev/null | tail -1 || true)"
    echo "Graph UI:  http://${DDEV_SITENAME}.ddev.site:${http_port:-9760}"
    echo "           https://${DDEV_SITENAME}.ddev.site:${https_port:-9761}"
    echo ""
    echo "No agent needed: the bridge opens a short-lived session of its own on the"
    echo "first request, so the graph is browsable on its own. The first load after"
    echo "an idle spell takes a moment while that starts."
    echo ""
    # Ask /health rather than requesting the UI itself. A request to the UI would
    # start the daemon, so a status command would have the side effect of spinning
    # up a server process and holding it for the idle timeout.
    health="$(in_container curl -sS --max-time 5 "http://127.0.0.1:9760/health" 2>/dev/null || true)"
    # `ddev exec` starts a stopped project on its own, so reaching this means the
    # container is up but the bridge did not answer, not that nothing is running.
    if ! grep -q '"status"' <<<"${health}"; then
      echo "Status: the bridge did not answer — see 'ddev cbm logs'"
    elif grep -qE '"ui_keeper":[[:space:]]*true' <<<"${health}"; then
      echo "Status: up (the bridge is holding a session open for the UI)"
    elif grep -qE '"sessions":[[:space:]]*[1-9]' <<<"${health}"; then
      echo "Status: up (an agent session is holding it open)"
    else
      echo "Status: idle — the next request to the URL above starts it"
    fi
    ;;

  logs)
    shift
    ddev logs -s "${SERVICE}" "$@"
    ;;

  shell|bash)
    ddev ssh -s "${SERVICE}"
    ;;

  version)
    in_container codebase-memory-mcp --version
    ;;

  *)
    tool="$1"
    shift
    if needs_project "${tool}" && ! has_project_flag "$@"; then
      project="$(resolve_project)"
      if [ -n "${project}" ]; then
        set -- --project "${project}" "$@"
      fi
    fi
    in_container codebase-memory-mcp cli "${tool}" "$@"
    ;;
esac
