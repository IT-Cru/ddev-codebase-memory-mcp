#ddev-generated
# Codebase Memory MCP container for DDEV
# Ubuntu 24.04 + codebase-memory-mcp (static "portable" build) + HTTP bridge
#
# The MCP server speaks stdio only, so it cannot be registered with a URL. A
# small stdlib-only Python bridge (mcp-http-bridge.py) puts MCP Streamable HTTP
# in front of it and gives each MCP session its own child process.

FROM ubuntu:24.04

ARG USERNAME=cbm
ARG USER_UID
ARG USER_GID

# Release to install, pinned to a version this add-on has been tested against.
#
# Deliberately not "latest". Upstream releases can change the published assets —
# v0.10.0 dropped the separate UI archive — and with "latest" that lands as a
# failed build on the next fresh image, with no warning and nothing changed on
# this side. Pinning turns an upstream change into an add-on update instead.
#
# "latest" is still accepted if you want it, and any tag can be pinned:
#   ddev dotenv set .ddev/.env.codebase-memory --cbm-version=latest
ARG CBM_VERSION=v0.10.3

ENV DEBIAN_FRONTEND=noninteractive
ENV USERNAME=${USERNAME}
ENV USER_HOME=/home/${USERNAME}

# python3: runs the HTTP bridge and the graph UI reverse proxy — standard library
#   only, no pip, no wheels, so nothing third-party sits between an agent and
#   your source.
# jq: the entrypoint merges MCP registrations into .mcp.json / opencode.json.
# git: required by the detect_changes tool.
# zstd: for the .codebase-memory/graph.db.zst shared-graph artifact.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    sudo \
    zstd \
    && rm -rf /var/lib/apt/lists/*

# Fail the build here rather than at runtime if the base image ever ships a
# Python without these modules.
RUN python3 -c "import http.server, json, queue, subprocess, threading, uuid, socketserver" \
    && python3 --version

# Install the codebase-memory-mcp binary from GitHub Releases.
#
# Linux MUST use the "-portable" asset: the plain linux binary dynamically links
# glibc 2.38+, while -portable is fully static. See upstream install.sh.
#
# One archive per platform, graph UI included. Upstream still publishes "ui-*"
# copies so old updaters keep working, but those names are absent from
# checksums.txt — verifying the download means using the canonical name.
#
# The binary is placed directly on PATH rather than via `<binary> install`,
# which would also rewrite agent configs and manage a host PATH we do not want
# inside an image layer.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      amd64|arm64) ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    archive="codebase-memory-mcp-linux-${arch}-portable.tar.gz"; \
    if [ "${CBM_VERSION}" = "latest" ]; then \
      base="https://github.com/DeusData/codebase-memory-mcp/releases/latest/download"; \
    else \
      base="https://github.com/DeusData/codebase-memory-mcp/releases/download/${CBM_VERSION}"; \
    fi; \
    tmp="$(mktemp -d)"; \
    curl -fsSL --retry 3 --retry-delay 2 -o "${tmp}/${archive}" "${base}/${archive}"; \
    curl -fsSL --retry 3 --retry-delay 2 -o "${tmp}/checksums.txt" "${base}/checksums.txt"; \
    expected="$(awk -v a="${archive}" '$2 == a || $2 == "*"a {print $1}' "${tmp}/checksums.txt" | head -n1)"; \
    if ! printf '%s' "${expected}" | grep -Eq '^[0-9a-fA-F]{64}$'; then \
      echo "error: no valid SHA-256 digest for ${archive} in checksums.txt" >&2; exit 1; \
    fi; \
    echo "${expected}  ${tmp}/${archive}" | sha256sum -c -; \
    tar -xzf "${tmp}/${archive}" -C "${tmp}"; \
    install -m 0755 "${tmp}/codebase-memory-mcp" /usr/local/bin/codebase-memory-mcp; \
    rm -rf "${tmp}"; \
    codebase-memory-mcp --version

# Create user with matching UID/GID from host (same approach as the sibling
# AI add-ons, so files written into the bind-mounted project stay host-owned)
RUN existing_user=$(getent passwd ${USER_UID} | cut -d: -f1) \
    && existing_group=$(getent group ${USER_GID} | cut -d: -f1) \
    && if [ -n "$existing_user" ] && [ "$existing_user" != "${USERNAME}" ]; then \
         userdel -r $existing_user 2>/dev/null || true; \
       fi \
    && if [ -n "$existing_group" ] && [ "$existing_group" != "${USERNAME}" ]; then \
         groupdel $existing_group 2>/dev/null || true; \
       fi \
    && groupadd --gid ${USER_GID} ${USERNAME} 2>/dev/null || true \
    && useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} 2>/dev/null || true \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME} \
    && passwd -d ${USERNAME}

# The cache directory must exist *in the image* with the right ownership: Docker
# seeds a fresh named volume from the image path, and would otherwise create it
# root-owned and leave the unprivileged container user unable to write the graph.
RUN mkdir -p /var/www/html ${USER_HOME}/.cache/codebase-memory-mcp \
    && chown -R ${USER_UID}:${USER_GID} ${USER_HOME} \
    && chown -R ${USER_UID}:${USER_GID} /var/www/html

# Copied as root so no in-container privilege escalation is needed to make them
# executable.
COPY codebase-memory-build/mcp-http-bridge.py /usr/local/bin/mcp-http-bridge.py
COPY codebase-memory-build/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/mcp-http-bridge.py /usr/local/bin/entrypoint.sh \
    && python3 -m py_compile /usr/local/bin/mcp-http-bridge.py

USER ${USERNAME}
WORKDIR ${USER_HOME}

# The bind-mounted project may be a git repo owned by a different UID than the
# container user in some DDEV/host combinations; detect_changes shells out to
# git, which refuses "dubious ownership" repositories.
RUN git config --global --add safe.directory /var/www/html

RUN echo 'alias ll="ls -la"' >> ~/.bashrc \
    && echo 'echo "Codebase Memory MCP container ready"' >> ~/.bashrc \
    && echo 'echo "  CLI: codebase-memory-mcp cli <tool> --help"' >> ~/.bashrc

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

WORKDIR /var/www/html
